{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "lint": "deno lint",
    "preview": "vite preview",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@noble/hashes": "npm:@noble/hashes@2.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.2",
    "fflate": "npm:fflate@0.8.3",
    "react": "npm:react@19.2.7",
    "react-dom": "npm:react-dom@19.2.7",
    "@types/react": "npm:@types/react@19.2.17",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.0.3",
    "tailwindcss": "npm:tailwindcss@4.3.2",
    "vite": "npm:vite@8.1.3",
    "zustand": "npm:zustand@5.0.14"
  }
}
